#!/usr/bin/env bash
# Rebuild and restart the systemd user service, then verify the app responds.
# The unit's ExecStartPre runs `pnpm run build`, so a restart is a full deploy.
set -euo pipefail
cd "$(dirname "$0")/.."

systemctl --user restart solar-sentinel.service

echo "Waiting for app on :49877..."
for _ in $(seq 1 30); do
  if curl -fsS "http://localhost:49877/api/weather" >/dev/null 2>&1; then
    echo "Deploy OK — app responding on :49877"
    exit 0
  fi
  sleep 2
done

echo "Deploy failed — app not responding on :49877 after 60s" >&2
journalctl --user -u solar-sentinel.service -n 20 --no-pager >&2
exit 1
